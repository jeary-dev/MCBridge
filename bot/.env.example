# Copy this file to ".env" (same folder) and fill it in.
# .env is in .gitignore - it holds your bot token, so it must NEVER be committed.

# Discord Developer Portal -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# Optional: your test Discord server's ID. Slash commands show up there instantly
# (without it they're registered globally, which can take a while).
# Discord: Settings -> Advanced -> Developer Mode, then right-click your server -> Copy Server ID
DEV_GUILD_ID=

# Where plugins connect. 8765 is the default.
HOST=0.0.0.0
PORT=8765

# The address server owners put in config.yml as bot-url (shown in /setup).
# Leave empty while testing locally. Later: wss://mcbridge.yourdomain.com/v1/plugin
PUBLIC_WS_URL=

# Two-way chat needs "Message Content Intent" turned on in the Developer Portal (Bot tab).
# Set to false if you haven't turned it on.
CHAT_BRIDGE=true

MAX_SERVERS_PER_GUILD=3
DB_PATH=mcbridge.db